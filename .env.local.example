# Copiez ce fichier en .env.local et remplissez les valeurs reelles.
# .env.local n'est jamais commite (voir .gitignore) — ce fichier ne sert
# qu'a documenter les noms de variables attendus par le site.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service role : jamais exposee au navigateur, utilisee uniquement par
# des routes serveur (webhook Stripe, sync abonnement).
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique du site (redirections email Supabase, succes/annulation Stripe) ---
NEXT_PUBLIC_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Prices Stripe (immuables une fois crees — voir CLAUDE.md)
STRIPE_PRICE_ID_LOGEMENTS=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_LOGEMENTS_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx

# --- n8n : secret partage pour authentifier les appels webhook ---
N8N_WEBHOOK_SECRET=

# --- n8n : URLs des webhooks encore utilisés par le site --------------------
# (create-property, delete-property, update-property-name, get-guide,
#  update-guide, get-reservations, create/delete/update-reservation,
#  generate-conv-code, get-messages, get-message-stats : supprimés -- le site
#  parle directement à Supabase pour tout ça, voir docs/migration-n8n-guide.md)
N8N_TOGGLE_WEBHOOK_URL=https://n8n.yourguestai.com/webhook/toggle-property
N8N_ICAL_WEBHOOK_URL=https://n8n.yourguestai.com/webhook/connect-ical
N8N_DEMO_REQUEST_WEBHOOK_URL=https://n8n.yourguestai.com/webhook/demo-request

# --- Analytics (chargés uniquement si l'hôte accepte les cookies de mesure
#     d'audience, voir CookieConsent.tsx / AnalyticsScripts.tsx) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=yj70bn8swk
