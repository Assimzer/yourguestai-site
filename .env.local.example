# Supabase — Project Settings > API dans ton dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxx...   # section "service_role", PAS anon — jamais NEXT_PUBLIC_

# Stripe — Dashboard Stripe (mode test) > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxx
STRIPE_PRICE_ID_LOGEMENTS=price_xxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx   # via `stripe listen` en local, via le Dashboard en prod

# URL publique du site
NEXT_PUBLIC_URL=http://localhost:3000

# n8n — URLs de tes webhooks (voir README pour la config des workflows)
N8N_TOGGLE_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/toggle-property
N8N_ICAL_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/connect-ical
N8N_DEMO_REQUEST_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/demo-request
N8N_CREATE_PROPERTY_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/create-property
N8N_DELETE_PROPERTY_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/delete-property
N8N_GET_GUIDE_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/get-guide
N8N_UPDATE_GUIDE_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/update-guide
N8N_STATS_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/get-message-stats

# Nouveaux webhooks à créer pour Réservations / Messages / code de conversation
N8N_RESERVATIONS_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/get-reservations
N8N_UPDATE_RESERVATION_NAME_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/update-reservation-name
N8N_GENERATE_CODE_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/generate-conv-code
N8N_MESSAGES_WEBHOOK_URL=https://yourguestai.app.n8n.cloud/webhook/get-messages

# Secret partagé entre ce site et n8n — génère une longue chaîne aléatoire,
# la même valeur doit être vérifiée dans chaque workflow n8n concerné.
N8N_WEBHOOK_SECRET=change-moi-en-chaine-aleatoire-longue
