# Copiez ce fichier en .env.local et remplissez les valeurs reelles.
# .env.local n'est jamais commite (voir .gitignore) — ce fichier ne sert
# qu'a documenter les noms de variables attendus par le site.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service role : jamais exposee au navigateur, utilisee uniquement par
# des routes serveur (webhook Stripe, sync abonnement).
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique du site (redirections email Supabase, succes/annulation Stripe) ---
NEXT_PUBLIC_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Prices Stripe (immuables une fois crees — voir CLAUDE.md)
STRIPE_PRICE_ID_LOGEMENTS=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_LOGEMENTS_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx

# --- n8n : secret partage pour authentifier les appels webhook ---
N8N_WEBHOOK_SECRET=

# --- n8n : URLs des webhooks (guestai.app.n8n.cloud) ---
N8N_CREATE_PROPERTY_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/create-property
N8N_DELETE_PROPERTY_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/delete-property
N8N_TOGGLE_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/toggle-property
N8N_UPDATE_PROPERTY_NAME_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/update-property-name
N8N_ICAL_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/connect-ical
N8N_GET_GUIDE_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/get-guide
N8N_UPDATE_GUIDE_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/update-guide
N8N_MESSAGES_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/get-messages
N8N_STATS_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/get-message-stats
N8N_RESERVATIONS_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/get-reservations
N8N_DELETE_RESERVATION_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/delete-reservation
N8N_UPDATE_RESERVATION_NAME_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/update-reservation-name
N8N_GENERATE_CODE_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/generate-conv-code
N8N_DEMO_REQUEST_WEBHOOK_URL=https://guestai.app.n8n.cloud/webhook/demo-request
